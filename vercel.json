{
  "rewrites": [
    { "source": "/products/:id/preview.jpg", "destination": "/api/catalogue?action=product-preview&id=:id" },
    { "source": "/products/:id", "destination": "/api/catalogue?action=product&id=:id" },
    { "source": "/((?!api/|assets/|catalogue/|products/|product-page.css|product-page.js|favicon.svg|fibro-logo.png|fibro-round-logo-v1.jpg|fibro-catalogue-share-v1.png|fibro-catalogue-share-v2.jpg|yorvis-share.png).*)", "destination": "/index.html" }
  ],
  "functions": { "api/catalogue.ts": { "maxDuration": 60, "includeFiles": "public/catalogue/images/**" } },
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "X-Frame-Options", "value": "DENY" },
    { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
    { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" }
  ]}, { "source": "/catalogue/products.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }]
}
