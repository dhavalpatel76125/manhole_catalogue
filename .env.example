VITE_ADMIN_PATH=/hdhdhdhhdhdcurioo
VITE_WHATSAPP_NUMBER=918320587916
# Set after choosing your live domain. Must be the full HTTPS domain root.
# Enables the branded image when the main URL is shared on social/messaging apps.
VITE_SITE_URL=https://manhole-catalogue.vercel.app
# Production defaults to online admin. Set false only for legacy static hosting.
# For local online development, use Vercel CLI and set this to true.
VITE_ONLINE_ADMIN=true
# Development preview only. Never used by a production build.
VITE_DEMO_MODE=false

# SERVER-ONLY variables. Set these in Vercel; never prefix them with VITE_.
# Connect a PRIVATE Vercel Blob store to populate this token automatically.
BLOB_READ_WRITE_TOKEN=
APP_ORIGIN=https://manhole-catalogue.vercel.app
ADMIN_EMAIL=admin@gmail.com
# Generate a random token of at least 32 characters for one-time admin setup.
ADMIN_SETUP_TOKEN=
